    "fields": [
      [
        "31:0",
        "OPTKEY",
        "解锁选项字节写入。",
        "顺序｜主控制器先解锁，再依次写 0x45670123、0xCDEF89AB。"
      ]
    ],
    "example": {
      "title": "最小寄存器示例",
      "explanation": "HSI 已开且就绪，FPEC 已解锁，等待 BSY=0 后操作。 选项字节改动会影响下次复位的启动状态。先保存 RDP、USER、DATA 和 WRP 策略，整组修改后复位核对。",
      "code": "FLASH->OPTKEYR = 0x45670123u;\nFLASH->OPTKEYR = 0xCDEF89ABu;"
    },
    "check": "读 CR.OPTWRE=1。仍为零先查 LOCK 与 BSY。",
    "instances": "STM32F103C8T6",
