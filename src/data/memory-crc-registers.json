      ],
      [
        "0",
        "BSY",
        "擦除或编程期间由硬件置位。"
      ]
    ],
    "example": {
      "title": "最小寄存器示例",
      "explanation": "HSI 已开且就绪，FPEC 已解锁，等待 BSY=0 后操作。 已记录本次 EOP。",
      "code": "FLASH->SR = FLASH_SR_EOP;"
